% ═══════════════════════════════════════════════════════════

main :-
    write('🔗 Solana Block Predictor'), nl,
    write('Self-modifying Prolog that predicts next block'), nl,
    write('═══════════════════════════════════════════════════════════'), nl,
    nl,
    
    write('To run:'), nl,
    write('  ?- solana_loop.  % Compact version'), nl,
    write('  ?- process_block_stream.  % Full version'), nl.

