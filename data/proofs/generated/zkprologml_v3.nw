            format(Stream, '~w,~w,~w,~w,~w,~w,~w,~w,~w,~w,~w,~w~n',
                   [Time, Freq, Temp, Load, MemUsed, MemTotal, DiskUsed, DiskTotal, Rx, Tx, ProcCPU, ProcMem]))),
    
    close(Stream),
    format('✅ Exported to ~w~n', [File]).

% ═══════════════════════════════════════════════════════════
% PART 10: Quick Test
