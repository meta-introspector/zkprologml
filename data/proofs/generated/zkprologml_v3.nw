    write(S, '(** Trisimulation: Prolog ↔ LLM(CPU) ↔ LLM(GPU) *)\n\n'),
    write(S, 'Require Import UniMath.Foundations.All.\n'),
    write(S, 'Require Import UniMath.CategoryTheory.Core.Categories.\n\n'),
    
    write(S, '(** The three systems as types *)\n'),
