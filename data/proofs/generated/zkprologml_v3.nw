load_lists_of_lists :-
    meta_parquet(File),
    format('🗂️  Loading meta parquet: ~w~n', [File]),
    
    % Use DuckDB to read
    format(atom(Cmd), 'duckdb -c "SELECT * FROM read_parquet(\'~w\')" > lists_of_lists.txt', [File]),
