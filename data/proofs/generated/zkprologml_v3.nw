    (display "  Code: ") (display code)
    (display " = ") (display sig-before) (newline)
    (display "  Eval: ") (display result)
    (display " = ") (display sig-after) (newline)
    (display "  Preserved: ") (display (equal? sig-before sig-after))
    (newline) (newline)))

