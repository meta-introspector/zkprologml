    member(scheme, Path).   % Scheme twice!

creates_hierarchy(Path) :-
    length(Path, N),
    N > 10.  % 13 levels!

loops_back(Path) :-
    Path = [_|Rest],
    last(Rest, scheme),
    member(scheme, Rest).  % Appears twice!

