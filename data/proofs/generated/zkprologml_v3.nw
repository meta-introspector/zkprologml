    write('═══════════════════════════════════════════════════════════'), nl,
    nl,
    
    % Generate programs
    write('Step 1: Generating programs...'), nl,
    shell('rustc generate_complexity_programs.rs -o generate_complexity_programs', _),
    shell('./generate_complexity_programs', _),
    nl,
    
    % Analyze measurements
