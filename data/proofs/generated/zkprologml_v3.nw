% Prove old Prolog = new Prolog (with zkPrologML)
prove_equivalence(OldProlog, NewProlog, Proof) :-
    write('📜 PROVING EQUIVALENCE'), nl,
    format('  Old: ~w~n', [OldProlog]),
    format('  New: ~w~n', [NewProlog]),
    nl,
    
    % Test predicate in both
