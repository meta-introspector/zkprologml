% ENUM IN C, SCHEME, PROLOG
% ═══════════════════════════════════════════════════════════

% C enum
c_enum(color, [red, green, blue]).

c_enum_code(color, '
typedef enum {
    RED = 0,
    GREEN = 1,
    BLUE = 2
} Color;

Color get_color(int n) {
    switch(n) {
        case 0: return RED;
        case 1: return GREEN;
        case 2: return BLUE;
        default: return RED;
    }
}
').

% Scheme enum (as symbols)
scheme_enum(color, '
(define (make-color n)
  (cond
    ((= n 0) \'red)
    ((= n 1) \'green)
    ((= n 2) \'blue)
    (else \'red)))

(define (color-value c)
  (cond
    ((eq? c \'red) 0)
    ((eq? c \'green) 1)
    ((eq? c \'blue) 2)))
').

% Prolog enum (as facts)
prolog_enum(color, [
    color(red, 0),
    color(green, 1),
    color(blue, 2)
]).

