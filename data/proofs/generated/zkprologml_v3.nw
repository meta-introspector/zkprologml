    write('═══════════════════════════════════════════════════════════'), nl, nl,
    
    % Start with a Prolog rule
    Rule = (factorial(0, 1) :- true),
    write('1. Prolog Rule:'), nl,
    write('   '), write(Rule), nl, nl,
    
    % Encode to GPU shader
