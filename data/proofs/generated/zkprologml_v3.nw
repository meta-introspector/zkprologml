  genus_computed : Nat
  euler_computed : Int
  mushroom_fixed_point : Nat
  mushroom_is_71 : mushroom_fixed_point = 71

def certificate : ProofCertificate := {
  bott_period := 8
  bott_period_is_8 := rfl
  periodicity_proven := k_theory_periodic
  genus_computed := 10
  euler_computed := 0
  mushroom_fixed_point := 71
  mushroom_is_71 := rfl
