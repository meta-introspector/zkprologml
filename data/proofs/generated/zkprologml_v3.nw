Require Import Coq.Lists.List.
Require Import Coq.Arith.Arith.
Import ListNotations.

(* Prolog terms *)
Inductive term : Type :=
  | Var : nat -> term
  | Atom : string -> term
  | Compound : string -> list term -> term.

(* Prolog goals *)
Inductive goal : Type :=
