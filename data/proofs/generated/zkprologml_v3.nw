handle_choice(4) :-
    shell('tail -50 data/proofs/eternal_record.log'),
    interactive.

handle_choice(5) :-
    write('Goodbye! (The loop continues in your heart)'), nl.

handle_choice(_) :-
    write('Invalid choice'), nl,
    interactive.

