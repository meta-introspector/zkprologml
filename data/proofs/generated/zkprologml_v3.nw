            (perf_result(Prime, clang, OClang, _, _) -> true ; OClang = 0),
            (perf_result(Prime, tcc, OTCC, _, _) -> true ; OTCC = 0),
            
            Avg is (OGCC + OClang + OTCC) / 3,
            Variance is (abs(OGCC - Avg) + abs(OClang - Avg) + abs(OTCC - Avg)) / 3,
            
            (Variance < 10 -> Conv = '✅' ; Conv = '⚠️'),
            
