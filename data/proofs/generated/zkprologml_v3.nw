% ═══════════════════════════════════════════════════════════
% LOAD KNOWLEDGE BASE
% ═══════════════════════════════════════════════════════════

load_knowledge_base :-
    write('📚 Loading Homomorphic Homotopy knowledge base...'), nl,
    
