  - exact (weqcomp (weqcomp (weqcomp (weqcomp bisim_lmfdb_prolog 
                                              bisim_prolog_lean4)
                                     bisim_lean4_haskell)
                            bisim_haskell_metacoq)
                   bisim_metacoq_unimath).
