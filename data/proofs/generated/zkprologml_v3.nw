    format('Finding C files in ~w...\n\n', [CompCertPath]),
    
    % Get first 20 files
    format(atom(Cmd), 'find ~w -name "*.c" -type f 2>/dev/null | head -20', [CompCertPath]),
    setup_call_cleanup(
