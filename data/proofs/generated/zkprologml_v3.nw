Qed.

(** * Theory Translation *)

(** Any theorem in any system can be translated to any other *)
Definition translate_theorem (T : Type) (from to : UU) : Type := T.

Theorem translation_preserves_truth (T : Type) (from to : UU) :
  T -> translate_theorem T from to.
Proof.
